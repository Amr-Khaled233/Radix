# Injected by the Neon integration (Phase 2 — map names if Vercel injects different ones)
DATABASE_URL=                 # pooled — runtime
DATABASE_URL_UNPOOLED=        # direct — migrations

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=              # e.g. https://radix.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

BLOB_READ_WRITE_TOKEN=        # injected by Vercel Blob

RESEND_API_KEY=
EMAIL_FROM="RADIX <no-reply@your-domain>"

DEFAULT_LOCALE=en

SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_PASSWORD=

NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Show /styleguide in production builds (e.g. on a preview deployment)
ENABLE_STYLEGUIDE=false
