# Injected by the Neon integration (Phase 2 — map names if Vercel injects different ones)
DATABASE_URL=                 # pooled — runtime
DATABASE_URL_UNPOOLED=        # direct — migrations

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=              # e.g. https://radix.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

BLOB_READ_WRITE_TOKEN=        # injected by Vercel Blob

# Email over SMTP with an app password (Gmail: Google Account → Security → 2-Step Verification → App passwords)
SMTP_USER=                    # e.g. radix.studio@gmail.com
SMTP_PASSWORD=                # the 16-character app password (not your normal password)
# Optional — defaults shown. For Outlook use smtp.office365.com and port 587.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Optional — defaults to "RADIX <SMTP_USER>". With Gmail it must be that address (or a verified alias).
# EMAIL_FROM=
# Local only: log email links to the console in a production build (`pnpm start`). Never set on Vercel.
# EMAIL_TRANSPORT=console
# Local only: store uploads in .data/uploads in a production build. Never set on Vercel.
# MEDIA_STORAGE=local

DEFAULT_LOCALE=en
# IANA time zone for dates (e.g. Africa/Cairo, Asia/Dubai)
SITE_TIME_ZONE=UTC

SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_PASSWORD=

NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Show /styleguide in production builds (e.g. on a preview deployment)
ENABLE_STYLEGUIDE=false
